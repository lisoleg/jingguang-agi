        # 中面板
        self.chat_label.place(x=480, y=105)
        self.chat_area.place(x=480, y=135, width=580, height=650)
        self.input_entry.place(x=480, y=800, width=450, height=40)
        self.send_btn.place(x=940, y=800, width=120, height=40)
        
        # 右面板
        self.dikwp_label.place(x=1090, y=105)
        self.dikwp_frame.place(x=1090, y=135, width=380, height=200)
        self.persona_label.place(x=1090, y=350)
        self.persona_frame.place(x=1090, y=380, width=380, height=120)
        self.analysis_label.place(x=1090, y=515)
        self.analysis_text.place(x=1090, y=545, width=380, height=150)
