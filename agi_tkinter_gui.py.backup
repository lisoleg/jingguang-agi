# ============ 动态测试集生成器 ============
class TestSetGenerator:
    """动态生成测试集"""
    @staticmethod
    def generate_set(num_per_dimension: int = 6) -> Dict:
        """从题库中随机选择题目，生成测试集"""
        test_set = {}
        colors = {
            "基础操作": {"color": "#00ffff", "icon": "🔧"},
            "生产力": {"color": "#00ff80", "icon": "📊"},
            "长链鲁棒性": {"color": "#ffa500", "icon": "🔗"},
            "推理与逻辑": {"color": "#8a2be6", "icon": "🧠"},
            "常识与知识": {"color": "#ff1493", "icon": "📚"},
        }
        
        for dim_name, questions in QUESTION_BANK.items():
            # 随机选择指定数量的题目
            selected = random.sample(questions, min(num_per_dimension, len(questions)))
            test_set[dim_name] = {
                "color": colors[dim_name]["color"],
                "icon": colors[dim_name]["icon"],
                "questions": selected
            }
        
        return test_set
    
    @staticmethod
    def save_to_file(test_set: Dict, filepath: str):
        """保存测试集到文件"""
        with open(filepath, 'w', encoding='utf-8') as f:
            json.dump(test_set, f, ensure_ascii=False, indent=2)
    
    @staticmethod
    def load_from_file(filepath: str) -> Dict:
        """从文件加载测试集"""
        with open(filepath, 'r', encoding='utf-8') as f:
            return json.load(f)


# ============ 知识库 ============
KNOWLEDGE_BASE = {
    "黎曼猜想": """黎曼猜想（Riemann Hypothesis）是数学中最著名的未解决问题之一...""",
    "哥德巴赫猜想": """哥德巴赫猜想是数论中最古老的未解决问题之一...""",
    "费马大定理": """费马大定理由皮埃尔·德·费马于1637年提出...""",
    "量子计算": """量子计算是利用量子力学现象（叠加和纠缠）进行计算的技术...""",
    "相对论": """爱因斯坦相对论包括狭义相对论（1905年）和广义相对论（1915年）...""",
    "深度学习": """深度学习是机器学习的子集，使用多层神经网络学习数据表示...""",
    "Python": """Python是由Guido van Rossum于1991年创建的高级编程语言...""",
    "二战": """第二次世界大战（1939-1945年）是人类历史上规模最大的战争...""",
}

# ============ 知识搜索 ============
def search_knowledge(query: str) -> Optional[str]:
    """搜索知识库"""
    query_lower = query.lower()
    for key, value in KNOWLEDGE_BASE.items():
        if key in query_lower:
            return value
    keywords = {
        "黎曼": "黎曼猜想", "素数": "黎曼猜想", "零点": "黎曼猜想",
        "哥德巴赫": "哥德巴赫猜想", "费马": "费马大定理",
        "量子": "量子计算", "相对论": "相对论", "爱因斯坦": "相对论",
        "深度学习": "深度学习", "Python": "Python", "二战": "二战",
    }
    for kw, topic in keywords.items():
        if kw in query_lower:
            return KNOWLEDGE_BASE.get(topic)
    return None


# ============ 颜色 - 赛博朋克风格 ============
COLORS = {
    'bg_dark': '#0a0a19',
    'bg_panel': '#14142a',
    'cyan': '#00ffff',
    'purple': '#8a2be2',
    'pink': '#ff1493',
    'green': '#00ff80',
    'yellow': '#ffff00',
    'white': '#ffffff',
    'gray': '#808080',
    'red': '#ff3232',
    'orange': '#ffa500',
}

# ============ DIKWP状态条组件 ============
class DIKWPBar(tk.Frame):
    """DIKWP状态条组件"""
    def __init__(self, parent, label, color, **kwargs):
        super().__init__(parent, **kwargs)
        self.configure(bg=COLORS['bg_panel'])
        self.color = color
        self.var = tk.DoubleVar(value=0.0)
        
        lbl = tk.Label(self, text=label, bg=COLORS['bg_panel'], fg=color, font=('Consolas', 10, 'bold'), width=6, anchor='w')
        lbl.pack(side='left', padx=(0, 2))
        
        self.bar = ttk.Progressbar(self, variable=self.var, maximum=1.0, length=200, mode='determinate')
        self.bar.pack(side='left', fill='x', expand=True, padx=2)
        
        self.val_lbl = tk.Label(self, text="0%", bg=COLORS['bg_panel'], fg=color, font=('Consolas', 9), width=6, anchor='e')
        self.val_lbl.pack(side='left', padx=(2, 0))
    
    def set_value(self, value: float):
        self.var.set(min(max(value, 0.0), 1.0))
        pct = int(self.var.get() * 100)
        self.val_lbl.config(text=f"{pct}%")


# ============ 意图流形可视化组件 ============
class CurvatureCanvas(tk.Canvas):
    """意图流形可视化"""
    def __init__(self, parent, **kwargs):
        super().__init__(parent, bg=COLORS['bg_dark'], highlightthickness=0, **kwargs)
        self.intent_type = 'N/A'
        self.curvature = 0.0
        self.rotation = 0
        self._draw()
        self._animate()
    
    def set_intent(self, curvature: float, intent_type: str):
        self.curvature = curvature
        self.intent_type = intent_type
        self._draw()
    
    def _animate(self):
        self.rotation += 1
        self._draw()
        self.after(50, self._animate)
    
    def _draw(self):
        self.delete('all')
        w, h = self.winfo_width(), self.winfo_height()
        if w < 10 or h < 10:
            return
        cx, cy = w // 2, h // 2
        base_r = 30 + int(self.curvature * 50)
        colors = {'task': COLORS['cyan'], 'query': COLORS['green'], 'analysis': COLORS['purple'], 'learning': COLORS['orange'], 'creative': COLORS['pink']}
        color = colors.get(self.intent_type, COLORS['cyan'])
        for i in range(3):
            r = base_r + i * 20
            try:
                self.create_oval(cx - r, cy - r, cx + r, cy + r, outline=color, width=2)
            except:
                pass
        try:
            self.create_oval(cx - base_r, cy - base_r, cx + base_r, cy + base_r, fill=color, outline='')
        except:
            pass
        try:
            self.create_text(cx, cy + base_r + 20, text=self.intent_type, fill=COLORS['white'], font=('Microsoft YaHei', 10))
        except:
            pass
        try:
            self.create_text(cx, cy, text=f"κ={self.curvature:.2f}", fill=COLORS['yellow'], font=('Consolas', 12, 'bold'))
        except:
            pass

# ============ 测试面板（分类标签页 + 动态生成 + 编辑）============
class AGITestPanel(tk.Frame):
    """AGI测试面板 - 按维度分类显示，支持动态生成和编辑"""
    def __init__(self, parent, on_test_select, on_run_all, on_regenerate, on_edit, **kwargs):
        super().__init__(parent, **kwargs)
        self.configure(bg=COLORS['bg_panel'])
        self.on_test_select = on_test_select
        self.on_run_all = on_run_all
        self.on_regenerate = on_regenerate
        self.on_edit = on_edit
        self.test_buttons = {}
        self.test_set = {}
        self._create_widgets()
    
    def _create_widgets(self):
        # 标题
        title = tk.Label(self, text="🧪 AGI 测试集", bg=COLORS['bg_panel'], fg=COLORS['cyan'], font=('Microsoft YaHei', 12, 'bold'))
        title.pack(anchor='w', padx=10, pady=(10, 5))
        
        # 说明
        desc = tk.Label(self, text="按维度分类 | 点击单题测试 | 可全部运行", bg=COLORS['bg_panel'], fg=COLORS['gray'], font=('Microsoft YaHei', 9))
        desc.pack(anchor='w', padx=10, pady=(0, 10))
        
        # 按钮区域
        btn_frame = tk.Frame(self, bg=COLORS['bg_panel'])
        btn_frame.pack(fill='x', padx=5, pady=5)
        
        # 换一组按钮
        regen_btn = tk.Button(
            btn_frame, text="🔄 换一组",
            command=self.on_regenerate,
            bg=COLORS['orange'], fg=COLORS['bg_dark'],
            font=('Microsoft YaHei', 10, 'bold'),
            relief='flat', padx=10, pady=5
        )
        regen_btn.pack(side='left', padx=5)
        
        # 编辑按钮
        edit_btn = tk.Button(
            btn_frame, text="✏️ 编辑",
            command=self.on_edit,
            bg=COLORS['purple'], fg=COLORS['white'],
            font=('Microsoft YaHei', 10, 'bold'),
            relief='flat', padx=10, pady=5
        )
        edit_btn.pack(side='left', padx=5)
        
        # 标签页控件
        self.notebook = ttk.Notebook(self)
        self.notebook.pack(fill='both', expand=True, padx=5, pady=5)
        
        # 底部按钮区域
        bottom_frame = tk.Frame(self, bg=COLORS['bg_panel'])
        bottom_frame.pack(fill='x', padx=5, pady=5)
        
        # 全部运行按钮
        run_all_btn = tk.Button(
            bottom_frame, text="🚀 全部运行（30题）",
            command=self.on_run_all,
            bg=COLORS['pink'], fg=COLORS['bg_dark'],
            font=('Microsoft YaHei', 11, 'bold'),
            relief='flat', padx=10, pady=5
        )
        run_all_btn.pack(fill='x', padx=5, pady=5)
        
        # 进度标签
        self.progress_label = tk.Label(bottom_frame, text="就绪", bg=COLORS['bg_panel'], fg=COLORS['yellow'], font=('Consolas', 9))
        self.progress_label.pack(anchor='w', padx=5, pady=(0, 5))
    
    def load_test_set(self, test_set: Dict):
        """加载测试集到界面"""
        self.test_set = test_set
        self.tab_frames = {}
        
        # 清除现有标签页
        for tab in self.notebook.tabs():
            self.notebook.forget(tab)
        
        # 为每个维度创建标签页
        self.tab_frames = {}
        for dim_name, dim_data in test_set.items():
            # 创建标签页
            tab_frame = tk.Frame(self.notebook, bg=COLORS['bg_panel'])
            self.notebook.add(tab_frame, text=f"{dim_data['icon']} {dim_name} ({len(dim_data['questions'])})")
            self.tab_frames[dim_name] = tab_frame
            
            # 在该标签页内创建滚动区域
            canvas = tk.Canvas(tab_frame, bg=COLORS['bg_panel'], highlightthickness=0)
            scrollbar = ttk.Scrollbar(tab_frame, orient='vertical', command=canvas.yview)
            scrollable_frame = tk.Frame(canvas, bg=COLORS['bg_panel'])
            
            scrollable_frame.bind('<Configure>', lambda e, c=canvas: c.configure(scrollregion=c.bbox('all')))
            canvas.create_window((0, 0), window=scrollable_frame, anchor='nw')
            canvas.configure(yscrollcommand=scrollbar.set)
            
            # 添加测试按钮
            self.test_buttons[dim_name] = []
            for q in dim_data['questions']:
                btn = tk.Button(
                    scrollable_frame,
                    text=f"{q['id']} [{q['difficulty']}] {q['question'][:35]}...",
                    command=lambda t=q: self.on_test_select(t),
                    bg=COLORS['bg_dark'], fg=dim_data['color'],
                    font=('Microsoft YaHei', 9),
                    relief='flat', anchor='w', wraplength=260, justify='left'
                )
                btn.pack(fill='x', padx=5, pady=2)
                self.test_buttons[dim_name].append(btn)
            
            canvas.pack(side='left', fill='both', expand=True)
            scrollbar.pack(side='right', fill='y')
    
    def update_progress(self, text):
        """更新进度显示"""
        self.progress_label.config(text=text)

# ============ 主界面 ============
class AGI_GUI(tk.Tk):
    """复合体AGI 7.0 主界面（100题 + 动态生成 + 编辑）"""
    
    def __init__(self, agi_system):
        super().__init__()
        self.agi = agi_system
        self.title("复合体AGI 7.0 - 100题测试 + 动态生成 + 编辑")
        self.geometry("1500x950")
        self.configure(bg=COLORS['bg_dark'])
        
        # 测试结果显示
        self.test_results = []
        self.current_test = None
        self.running_all = False
        self.current_test_set = {}
        
        self._create_widgets()
        self._layout()
        self._update_persona()
        self._load_initial_test_set()
    
    def _load_initial_test_set(self):
        """加载初始测试集（随机生成）"""
        self.current_test_set = TestSetGenerator.generate_set(num_per_dimension=6)
        self.test_panel.load_test_set(self.current_test_set)
    
    def _create_widgets(self):
        # === 标题栏 ===
        self.title_label = tk.Label(self, text="复合体AGI 7.0", bg=COLORS['bg_dark'], fg=COLORS['cyan'], font=('Microsoft YaHei', 24, 'bold'))
        self.subtitle_label = tk.Label(self, text="100题题库 · 动态生成 · 可编辑 · 一键全跑", bg=COLORS['bg_dark'], fg=COLORS['gray'], font=('Microsoft YaHei', 12))
        
        # === 左面板：意图流形 + 测试集 ===
        self.curvature_label = tk.Label(self, text="意图流形可视化", bg=COLORS['bg_dark'], fg=COLORS['white'], font=('Microsoft YaHei', 14, 'bold'))
        self.curvature_canvas = CurvatureCanvas(self, width=350, height=300)
        
        # 测试面板（支持动态生成和编辑）
        self.test_panel = AGITestPanel(
            self,
            on_test_select=self._on_test_select,
            on_run_all=self._on_run_all,
            on_regenerate=self._on_regenerate,
            on_edit=self._on_edit
        )
        
        # === 中面板：对话区 ===
        self.chat_label = tk.Label(self, text="对话交互（AGI主体）", bg=COLORS['bg_dark'], fg=COLORS['white'], font=('Microsoft YaHei', 14, 'bold'))
        self.chat_area = scrolledtext.ScrolledText(self, wrap=tk.WORD, width=50, height=25, bg=COLORS['bg_panel'], fg=COLORS['white'], font=('Microsoft YaHei', 11), insertbackground=COLORS['cyan'])
        self.chat_area.config(state='disabled')
        
        self.input_var = tk.StringVar()
        self.input_entry = tk.Entry(self, textvariable=self.input_var, bg=COLORS['bg_panel'], fg=COLORS['white'], font=('Microsoft YaHei', 12), insertbackground=COLORS['cyan'], relief='solid', bd=1)
        self.input_entry.bind('<Return>', self._send_message)
        
        self.send_btn = tk.Button(self, text="发送 🚀", command=self._send_message, bg=COLORS['cyan'], fg=COLORS['bg_dark'], font=('Microsoft YaHei', 11, 'bold'), relief='flat', padx=20)
        
        # === 右面板：DIKWP + 人格 + AGI分析 + 测试结果 ===
        self.dikwp_label = tk.Label(self, text="DIKWP 状态仪表盘", bg=COLORS['bg_dark'], fg=COLORS['white'], font=('Microsoft YaHei', 14, 'bold'))
        self.dikwp_frame = tk.Frame(self, bg=COLORS['bg_dark'])
        self.dikwp_bars = {
            'D': DIKWPBar(self.dikwp_frame, "Data", COLORS['cyan']),
            'I': DIKWPBar(self.dikwp_frame, "Info", COLORS['green']),
            'K': DIKWPBar(self.dikwp_frame, "Know", COLORS['purple']),
            'W': DIKWPBar(self.dikwp_frame, "Wisdom", COLORS['pink']),
            'P': DIKWPBar(self.dikwp_frame, "Purpose", COLORS['orange']),
        }
        for bar in self.dikwp_bars.values():
            bar.pack(fill='x', pady=5)
        
        # 人格面板
        self.persona_label = tk.Label(self, text="虚拟人格体", bg=COLORS['bg_dark'], fg=COLORS['white'], font=('Microsoft YaHei', 14, 'bold'))
        self.persona_frame = tk.Frame(self, bg=COLORS['bg_panel'])
        self.persona_name = tk.Label(self.persona_frame, text="", bg=COLORS['bg_panel'], fg=COLORS['cyan'], font=('Microsoft YaHei', 12, 'bold'), anchor='w')
        self.persona_mbti = tk.Label(self.persona_frame, text="", bg=COLORS['bg_panel'], fg=COLORS['purple'], font=('Microsoft YaHei', 11), anchor='w')
        self.persona_emotion = tk.Label(self.persona_frame, text="", bg=COLORS['bg_panel'], fg=COLORS['pink'], font=('Microsoft YaHei', 11), anchor='w')
        self.persona_cq = tk.Label(self.persona_frame, text="", bg=COLORS['bg_panel'], fg=COLORS['green'], font=('Microsoft YaHei', 11), anchor='w')
        self.persona_name.pack(fill='x', padx=10, pady=(10, 5))
        self.persona_mbti.pack(fill='x', padx=10, pady=5)
        self.persona_emotion.pack(fill='x', padx=10, pady=5)
        self.persona_cq.pack(fill='x', padx=10, pady=(5, 10))
        
        # AGI分析面板
        self.analysis_label = tk.Label(self, text="🧠 AGI分析过程", bg=COLORS['bg_dark'], fg=COLORS['white'], font=('Microsoft YaHei', 14, 'bold'))
        self.analysis_text = scrolledtext.ScrolledText(self, width=40, height=8, bg=COLORS['bg_panel'], fg=COLORS['yellow'], font=('Consolas', 9), wrap=tk.WORD)
        self.analysis_text.config(state='disabled')
        
        # 测试结果面板
        self.result_label = tk.Label(self, text="📊 测试结果汇总", bg=COLORS['bg_dark'], fg=COLORS['white'], font=('Microsoft YaHei', 14, 'bold'))
        self.result_text = scrolledtext.ScrolledText(self, width=40, height=8, bg=COLORS['bg_panel'], fg=COLORS['green'], font=('Consolas', 9), wrap=tk.WORD)
        self.result_text.config(state='disabled')

